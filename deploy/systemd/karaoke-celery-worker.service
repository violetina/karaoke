[Unit]
Description=Karaoke Celery worker (post-processing workflows)
Documentation=file:///home/tina/karaoke/docs/howto-post-processing.md
After=network-online.target karaoke-mq-forward.service
Wants=network-online.target karaoke-mq-forward.service
PartOf=karaoke.target

[Service]
Type=simple
WorkingDirectory=/home/tina/karaoke
Environment=PYTHONPATH=/home/tina/karaoke/src
Environment=KARAOKE_ORCHESTRATOR=celery
Environment=RABBITMQ_HOST=localhost
# Pull YouTube cookies from Chrome so downloads/captions authenticate as you (schizoid69@gmail.com).
Environment="KARAOKE_COOKIES_FROM_BROWSER=chrome+GNOMEKEYRING:Profile 2"
# Analysis is librosa/numpy; cap thread pools and let Celery manage process concurrency.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
# Four consumers for the fast steps; Whisper sync (karaoke-celery-sync) and
# CLAP take the rest of the slice's CPUQuota=600%. Recycling a process after
# 50 tasks bounds the librosa/madmom growth that pushed the slice into swap.
ExecStart=/home/tina/karaoke/.venv/bin/celery -A karaoke.celery_app:app worker -Q karaoke-postprocess-celery --loglevel=INFO --concurrency=4 --max-tasks-per-child=50 --events
Restart=always
RestartSec=5
SyslogIdentifier=karaoke-celery-worker

# Background work must never starve playback.
Nice=15
Slice=karaoke-postprocess.slice

[Install]
WantedBy=karaoke.target

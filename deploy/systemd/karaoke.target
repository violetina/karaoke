[Unit]
Description=Karaoke platform (all host-side services)
Documentation=file:///home/tina/karaoke/docs/howto-systemd-services.md
# Starting/stopping this target starts/stops every karaoke-*.service bound to it.
# Post-processing fans out as templated workers; RabbitMQ competing consumers
# distribute work while karaoke-postprocess.slice caps the group.
Wants=karaoke-api.service karaoke-ctrl-api.service karaoke-mq-forward.service karaoke-postprocess@1.service karaoke-postprocess@2.service karaoke-postprocess@3.service karaoke-postprocess@4.service karaoke-postprocess@5.service karaoke-postprocess@6.service

[Install]
WantedBy=default.target

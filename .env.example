# Copy to .env and edit. Real environment variables always win over this file.

# OpenSearch endpoint (host CLI: localhost via NodePort; in-cluster Job: the service DNS)
OPENSEARCH_URL=http://localhost:9200

# Your music library (audio source for karaoke + Whisper). ~/Music is the default.
MUSIC_DIR=/home/tina/Music

# Embedding model for lyric semantic search (384-dim -> matches index mapping)
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384

# OpenSearch index name
KARAOKE_INDEX=tracks

# LRCLIB API base (free, no key)
LRCLIB_BASE=https://lrclib.net

# Kube context the deploy/scanner scripts are allowed to use (must be kind-*)
KUBE_CONTEXT=kind-karaoke
